<table> 
    <thead>
        <tr>
            <th></th>
            <th>Title</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><input  type="checkbox"
                    name="workItemIds"
                    value="@item.Id" 
                    form="confirmForm"/></td>
                <td>@item.Title</td>
                <td> @if (item.IsConfirmed)
                    {
                        <span>Confirmed</span>
                    }
                    else
                    {
                        <span>Pending</span>
                    }
                </td>
                <td><a asp-action="Detail" asp-route-id="@item.Id" 
                class="btn btn-outline-primary" asp-route-sort="@ViewData["Sort"]"
                asp-route-page="@Model.CurrentPage">查看詳情</a>@if(item.IsConfirmed)
                {   <form asp-action="UndoConfirm" method="post" class="undo-form">
                    <input  type="hidden"
                            name="workItemId"
                            value="@item.Id" />
                    <button type="submit">UndoConfirm</button> 
                    </form>
                }</td>
            </tr>
        }
    </tbody>
</table>